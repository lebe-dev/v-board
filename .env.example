# Copy to `.env`. The value is read at build time; without a DSN the build cannot report errors
# and the settings page does not show the "Send errors to the developer" option.
SENTRY_DSN=

# Optional: upload the R8 mapping of a release build, so the tracker shows readable stacks.
# All four are needed. SENTRY_AUTH_TOKEN is the value of the `soika_session` cookie of a team admin;
# it expires with the session. Keep it out of the APK and out of git.
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Release signing (`just release`). `just release-key` creates the keystore; keep it outside the
# repository and back it up: without the same key no update installs over the published app.
RELEASE_KEYSTORE_FILE=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
