<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice input: needed by the system recognizer and for recording for Govorun or a server. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The optional text improvement on the user's own server and the downloads from GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installs an update downloaded from GitHub releases, after the user confirms it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Keeps the background update check, when it is on, scheduled after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility for the system recognizer and for Govorun's recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="com.govorun.api.RECOGNITION_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".KeyboardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales"
        android:supportsRtl="true">

        <!-- Sentry starts only from code, and only when the user has agreed to send errors. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Hands the saved clipboard images to the app that receives a pasted image. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clip_paths" />
        </provider>

        <service
            android:name=".update.UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- After an update, fetches the word pair table of the new version in place of the old one. -->
        <receiver
            android:name=".WordPairsRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".WordPairsRefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
